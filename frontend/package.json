{
  "name": "mikrocentauri-ui",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/budget.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
